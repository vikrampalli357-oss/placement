{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/history", "destination": "/api/history" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
